# Firebase project config — copy this file to .env and fill in real values.
# Find these under Firebase Console > Project Settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The ONLY email allowed to sign in to the admin dashboard.
# Must match the rule in firestore.rules / storage.rules.
VITE_ADMIN_EMAIL=mkhamim1050100@gmail.com

# Public site base URL, used for canonical URLs, sitemap, and JSON-LD.
VITE_SITE_URL=https://technest-ai-kappa.vercel.app
