rules_version = '2';

// Deploy: Firebase Console > Firestore Database > Rules, paste this in, Publish.
// Admin email must match VITE_ADMIN_EMAIL in .env.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "mkhamim1050100@gmail.com";
    }

    // Posts: anyone can read a PUBLISHED post (public blog needs this).
    // A 'scheduled' post also becomes publicly readable the moment its
    // publishedAt time passes — this is what makes scheduling "automatic"
    // without needing a Cloud Function/cron job to flip the status field.
    // Drafts (and scheduled posts whose time hasn't arrived yet) stay
    // private — only the admin can read them.
    // Only the admin can create/update/delete, from any state.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published'
        || (resource.data.status == 'scheduled' && resource.data.publishedAt <= request.time)
        || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories & tags: public read (used to build category pages / filters),
    // admin-only write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site-wide settings (e.g. site title, social links) — public read,
    // admin-only write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection — reserved for the single admin's own profile doc.
    // Nobody else should read or write this.
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
