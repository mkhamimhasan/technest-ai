rules_version = '2';

// Deploy: Firebase Console > Storage > Rules, paste this in, Publish.
// Admin email must match VITE_ADMIN_EMAIL in .env.

service firebase.storage {
  match /b/{bucket}/o {

    match /blog-images/{fileName} {
      // Anyone can view images (they're embedded in public blog posts).
      allow read: if true;

      // Only the admin can upload, and only actual images under 8MB —
      // mirrors the client-side check in storageService.js.
      allow write: if request.auth != null
        && request.auth.token.email == "mkhamim1050100@gmail.com"
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
